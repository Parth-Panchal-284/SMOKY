# RocketRide development connection (managed by the VS Code extension)
ROCKETRIDE_URI=https://staging.rocketride.ai:443
ROCKETRIDE_APIKEY=

# RocketRide deployment target (managed by the extension; only needed to deploy/publish)
ROCKETRIDE_DEPLOY_URI=https://staging.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=

# LLM used by the specialists and the chief agent.
# staging.rocketride.ai has NO org-level LLM key for this workspace, so one of
# these must be supplied. Match config/dataer.config.json -> llm.apikeyVar.
ROCKETRIDE_ANTHROPIC_KEY=
# ROCKETRIDE_OPENAI_KEY=

# Hotdata (teammate's half). Only needed when hotdata.enabled = true in
# config/dataer.config.json — that wires one db_hotdata node per specialist.
ROCKETRIDE_HOTDATA_KEY=
ROCKETRIDE_HOTDATA_WORKSPACE=
